{
  "author": "Mutualzz",
  "bugs": {
    "url": "https://git.mutualzz.com/mutualzz/mutualzz/issues"
  },
  "description": "Local IPC helper for Mutualzz desktop Rich Presence",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "bunchee": "^6.10.0",
    "eslint": "^10.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "PROTOCOL.md"
  ],
  "homepage": "https://git.mutualzz.com/mutualzz/mutualzz/tree/master/packages/rpc",
  "keywords": [
    "mutualzz",
    "rpc",
    "presence",
    "ipc",
    "rich-presence"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "name": "@mutualzz/rpc",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/rpc",
    "type": "git",
    "url": "https://github.com/Mutualzz/mutualzz"
  },
  "scripts": {
    "build": "pnpm typecheck && bunchee",
    "dev": "bunchee --watch",
    "lint": "eslint src",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.0"
}
